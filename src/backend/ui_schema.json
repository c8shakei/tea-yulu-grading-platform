{
  "appName": "恩施玉露茶品质分级与溯源平台",
  "version": "0.3.0",
  "theme": {
    "primary": "#2E7D32",
    "secondary": "#81C784",
    "background": "#F5F5F5",
    "text": "#212121"
  },
  "nav": [
    { "key": "dashboard", "label": "首页仪表盘", "icon": "DashboardOutlined", "path": "/" },
    { "key": "detect", "label": "检测工作台", "icon": "CameraOutlined", "path": "/detect" },
    { "key": "history", "label": "历史记录", "icon": "HistoryOutlined", "path": "/history" },
    { "key": "trace", "label": "溯源验证", "icon": "SafetyCertificateOutlined", "path": "/trace" },
    { "key": "profile", "label": "个人中心", "icon": "UserOutlined", "path": "/profile" },
    { "key": "lowcode", "label": "低代码演示", "icon": "CodeOutlined", "path": "/lowcode" },
    { "key": "training", "label": "训练曲线看板", "icon": "LineChartOutlined", "path": "/training" }
  ],
  "pages": {
    "dashboard": {
      "title": "首页仪表盘",
      "widgets": [
        { "type": "stat-card", "metric": "total_detections", "title": "总检测数" },
        { "type": "stat-card", "metric": "today_detections", "title": "今日检测" },
        { "type": "pie-chart", "metric": "grade_distribution", "title": "等级分布" },
        { "type": "line-chart", "metric": "weekly_trend", "title": "近 7 天趋势" }
      ]
    },
    "detect": {
      "title": "检测工作台",
      "widgets": [
        { "type": "image-upload", "api": "POST /api/detect", "title": "上传茶叶图片" },
        { "type": "result-card", "fields": ["class_name", "confidence", "bbox", "trace_id"] }
      ]
    },
    "history": {
      "title": "历史记录",
      "widgets": [
        { "type": "pie-chart", "api": "GET /api/stats/user/{user_id}", "metric": "grade_distribution", "title": "个人等级分布" },
        { "type": "line-chart", "api": "GET /api/stats/user/{user_id}", "metric": "confidence_trend", "title": "平均置信度趋势" },
        { "type": "data-table", "api": "GET /api/detections", "columns": ["created_at", "class_name", "confidence", "trace_id"] }
      ]
    },
    "trace": {
      "title": "溯源验证",
      "widgets": [
        { "type": "trace-input", "api": "GET /api/trace/{id}", "title": "输入 trace_id" },
        { "type": "trace-chain", "fields": ["index", "hash", "prev_hash", "timestamp", "payload"] }
      ]
    },
    "profile": {
      "title": "个人中心",
      "widgets": [
        { "type": "user-info", "api": "GET /api/auth/me" },
        { "type": "stat-card", "api": "GET /api/stats/user/{user_id}", "metric": "total_detections" },
        { "type": "pie-chart", "api": "GET /api/stats/user/{user_id}", "metric": "grade_distribution" },
        { "type": "line-chart", "api": "GET /api/stats/user/{user_id}", "metric": "confidence_trend" }
      ]
    },
    "lowcode": {
      "title": "低代码演示",
      "widgets": [
        { "type": "json-viewer", "api": "GET /api/ui/schema", "title": "当前 UI Schema" },
        { "type": "markdown", "content": "修改 src/backend/ui_schema.json 后刷新页面即可生效。" }
      ]
    },
    "training": {
      "title": "训练曲线看板",
      "widgets": [
        { "type": "image", "src": "/models/training_curves.png", "title": "W2 训练曲线" },
        { "type": "metrics", "src": "/models/test_metrics.json", "title": "检测指标" }
      ]
    }
  }
}
